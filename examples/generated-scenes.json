{
  "schemaVersion": 2,
  "disclosure": "AI-generated scenes",
  "output": {
    "path": "out/generated-scenes.mp4",
    "width": 1280,
    "height": 720,
    "fps": 30
  },
  "brand": {
    "colors": {
      "bg": "#0B0B0B",
      "fg": "#FFFFFF",
      "accent": "#3B82F6"
    }
  },
  "tracks": [
    {
      "id": "main",
      "clips": [
        {
          "type": "title_card",
          "duration": 2.0,
          "text": "Example Co.",
          "subtitle": "SAMPLE DATA"
        },
        {
          "type": "generated_scene",
          "provider": "xai-video",
          "model": "grok-imagine-video",
          "prompt": "A slow aerial shot of a small town at sunrise, soft light, no people, no text",
          "duration": 8,
          "resolution": "720p",
          "aspect_ratio": "16:9",
          "fallback": {
            "type": "image",
            "path": "assets/still.png",
            "kenburns": {
              "from": 1.0,
              "to": 1.08
            }
          }
        },
        {
          "type": "generated_scene",
          "provider": "xai-image",
          "model": "grok-imagine-image",
          "prompt": "A tidy shop front on a quiet street, morning light, no people, no text",
          "duration": 4,
          "aspect_ratio": "16:9",
          "kenburns": {
            "from": 1.0,
            "to": 1.06
          },
          "fallback": {
            "type": "title_card",
            "text": "Open every day"
          }
        },
        {
          "type": "title_card",
          "duration": 2.0,
          "text": "Example Co.",
          "subtitle": "example.com"
        }
      ]
    }
  ]
}
