"$PY" dist/ambitious-video.pyz render --offline --in "$WORK/recipe/recipe.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/recipe/render-a.json"
"$PY" dist/ambitious-video.pyz render --offline --in "$WORK/recipe/recipe.json" --now 2026-01-02T00:00:00Z --seed 2 </dev/null >"$WORK/recipe/render-b.json"
"$PY" - "$WORK/recipe" <<'PY'
import json, sys
from pathlib import Path
at = Path(sys.argv[1])
def read(name, ok=True):
    body = json.loads((at / f"{name}.json").read_text(encoding="utf-8"))
    if body["ok"] is not ok:
        raise SystemExit(body)
    return body
plan, again, est = (read(name)["data"] for name in ("plan-a", "plan-b", "estimate"))
if plan != again or [entry["env"] for entry in est["secretsNeeded"]] != ["XAI_API_KEY"]:
    raise SystemExit("recipe plan must repeat and list XAI_API_KEY")
refused = read("refused", ok=False)
if [error["code"] for error in refused["errors"]] != ["E_NO_KEY"]:
    raise SystemExit("recipe render without key must stop with E_NO_KEY")
one, two = (read(name)["data"] for name in ("render-a", "render-b"))
if one["costUsd"] != "0.000000" or one["sha256"] != two["sha256"]:
    raise SystemExit("recipe offline renders must repeat and cost 0.000000")
json.dump({"jobId": one["jobId"]}, open(at / "job.json", "w", encoding="utf-8"))
print("recipe", est["usd"], "usd online,", one["costUsd"], "offline", one["sha256"][:12])
PY
