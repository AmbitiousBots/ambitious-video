#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
unset XAI_API_KEY
if [ -z "${PY:-}" ] && [ -x .venv/bin/python ]; then
  PY=".venv/bin/python"
fi
PY="${PY:-python3}"
export PYTHONPATH="src:vendor${PYTHONPATH:+:$PYTHONPATH}"

echo "== copy, lint, types, tests =="
"$PY" scripts/check_copy.py
"$PY" scripts/check_comments.py src
"$PY" scripts/check_comments.py test
"$PY" -m ruff check src test
"$PY" -m mypy --strict src
"$PY" -m pytest -q

echo "== build and contract =="
"$PY" scripts/build.py
"$PY" -m ambitious_kit.contract dist/ambitious-video.pyz

HOME="$(mktemp -d)"
WORK="$(mktemp -d)"
cleanup() { rm -rf "$HOME" "$WORK"; }
trap cleanup EXIT
mkdir -p "$WORK/assets"
cp examples/minimal.yaml "$WORK/minimal.yaml"
cp examples/assets/still.png "$WORK/assets/still.png"
export AMBITIOUS_HOME="$HOME"

echo "== fresh selfcheck, render, verify, estimate =="
"$PY" dist/ambitious-video.pyz selfcheck --now 2026-01-01T00:00:00Z --seed 1
"$PY" dist/ambitious-video.pyz render --in "$WORK/minimal.yaml" --now 2026-01-01T00:00:00Z --seed 1 >"$WORK/render.json"
"$PY" - "$WORK/render.json" "$WORK/job.json" <<'PY'
import json, sys
body = json.load(open(sys.argv[1], encoding="utf-8"))
if not body["ok"]:
    raise SystemExit(body)
json.dump({"jobId": body["data"]["jobId"]}, open(sys.argv[2], "w", encoding="utf-8"))
print(body["data"]["jobId"], body["data"]["durationSec"], body["data"]["costUsd"])
PY
"$PY" dist/ambitious-video.pyz verify --in "$WORK/job.json" --now 2026-01-01T00:00:00Z --seed 1
"$PY" dist/ambitious-video.pyz estimate --in examples/all-clip-types.yaml --now 2026-01-01T00:00:00Z --seed 1

echo "== sample projects: validate and plan, no key =="
for sample in examples/samples/*/; do
  "$PY" dist/ambitious-video.pyz validate --in "${sample}script.yaml" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/sample.json"
  "$PY" dist/ambitious-video.pyz plan --in "${sample}script.yaml" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >>"$WORK/sample.json"
  "$PY" - "$WORK/sample.json" "$sample" <<'PY'
import json, sys
for line in open(sys.argv[1], encoding="utf-8"):
    body = json.loads(line)
    if not body["ok"]:
        raise SystemExit(body)
print(sys.argv[2], body["data"]["durationSec"], len(body["data"]["steps"]), "steps")
PY
done

echo "== help, version, guide: the printed example renders and verifies =="
"$PY" dist/ambitious-video.pyz --help --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/help.json"
"$PY" dist/ambitious-video.pyz --version --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/version.json"
"$PY" dist/ambitious-video.pyz guide --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/guide.json"
"$PY" - "$WORK" examples/titles-and-captions.yaml <<'PY'
import json, sys
from pathlib import Path
work = Path(sys.argv[1])
for name in ("help", "version", "guide"):
    body = json.loads((work / f"{name}.json").read_text(encoding="utf-8"))
    if not body["ok"] or body["command"] != name:
        raise SystemExit(body)
if json.loads((work / "version.json").read_text(encoding="utf-8"))["data"]["version"] != "0.1.0":
    raise SystemExit("--version did not report 0.1.0")
script = json.loads((work / "guide.json").read_text(encoding="utf-8"))["data"]["example"]["script"]
if script != Path(sys.argv[2]).read_text(encoding="utf-8"):
    raise SystemExit("guide does not print examples/titles-and-captions.yaml")
(work / "guide").mkdir()
(work / "guide" / "video.yaml").write_text(script, encoding="utf-8")
PY
"$PY" dist/ambitious-video.pyz validate --in "$WORK/guide/video.yaml" --now 2026-01-01T00:00:00Z --seed 1 </dev/null
"$PY" dist/ambitious-video.pyz render --in "$WORK/guide/video.yaml" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/guide-render.json"
"$PY" - "$WORK/guide-render.json" "$WORK/guide-job.json" <<'PY'
import json, sys
body = json.load(open(sys.argv[1], encoding="utf-8"))
if not body["ok"] or body["data"]["costUsd"] != "0.000000":
    raise SystemExit(body)
json.dump({"jobId": body["data"]["jobId"]}, open(sys.argv[2], "w", encoding="utf-8"))
print(body["data"]["jobId"], body["data"]["durationSec"], body["data"]["costUsd"])
PY
"$PY" dist/ambitious-video.pyz verify --in "$WORK/guide-job.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null
echo "verify/run: ok"
