(at / "small.json").write_text(json.dumps(doc, indent=2), encoding="utf-8")
PY
"$PY" dist/ambitious-video.pyz validate --in "$WORK/lips/lips.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >/dev/null
