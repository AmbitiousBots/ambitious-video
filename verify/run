#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
unset XAI_API_KEY ELEVENLABS_API_KEY SYNC_API_KEY
if [ -z "${PY:-}" ] && [ -x .venv/bin/python ]; then
  PY=".venv/bin/python"
fi
PY="${PY:-python3}"
export PYTHONPATH="src:vendor${PYTHONPATH:+:$PYTHONPATH}"

echo "== copy, lint, types, tests =="
"$PY" scripts/check_copy.py
"$PY" scripts/check_comments.py src
"$PY" scripts/check_comments.py test
"$PY" -m ruff check src test
"$PY" -m mypy --strict src
"$PY" -m pytest -q

echo "== build and contract =="
"$PY" scripts/build.py
"$PY" -m ambitious_kit.contract dist/ambitious-video.pyz

HOME="$(mktemp -d)"
WORK="$(mktemp -d)"
cleanup() { rm -rf "$HOME" "$WORK"; }
trap cleanup EXIT
mkdir -p "$WORK/assets"
cp examples/minimal.json "$WORK/minimal.json"
cp examples/assets/still.png "$WORK/assets/still.png"
export AMBITIOUS_HOME="$HOME"

echo "== fresh selfcheck, render, verify, estimate =="
"$PY" dist/ambitious-video.pyz selfcheck --now 2026-01-01T00:00:00Z --seed 1
"$PY" dist/ambitious-video.pyz render --in "$WORK/minimal.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/render.json"
"$PY" - "$WORK/render.json" "$WORK/job.json" <<'PY'
import json, sys
body = json.load(open(sys.argv[1], encoding="utf-8"))
if not body["ok"]:
    raise SystemExit(body)
json.dump({"jobId": body["data"]["jobId"]}, open(sys.argv[2], "w", encoding="utf-8"))
print(body["data"]["jobId"], body["data"]["durationSec"], body["data"]["costUsd"])
PY
"$PY" dist/ambitious-video.pyz verify --in "$WORK/job.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null
"$PY" dist/ambitious-video.pyz estimate --in examples/all-clip-types.json --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/estimate.json"
"$PY" - "$WORK/estimate.json" <<'PY'
import json, sys
body = json.load(open(sys.argv[1], encoding="utf-8"))
if not body["ok"]:
    raise SystemExit(body)
paid = [line for line in body["data"]["breakdown"] if "provider" in line]
named = ("provider", "model", "units", "usd", "sourceUrl", "checkedAt")
if not paid or any(not line.get(name) for line in paid for name in named) or any(line["cached"] for line in paid):
    raise SystemExit("a paid estimate line must name its provider, model, units, usd, sourceUrl and checkedAt")
print("estimate", body["data"]["usd"], "usd,", len(paid), "paid lines from", paid[0]["provider"], paid[0]["sourceUrl"])
PY

echo "== plan is the same bytes on another day, and the cache commands answer =="
"$PY" dist/ambitious-video.pyz plan --in "$WORK/minimal.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/plan-a.json"
"$PY" dist/ambitious-video.pyz plan --in "$WORK/minimal.json" --now 2031-07-09T12:34:56Z --seed 2 </dev/null >"$WORK/plan-b.json"
"$PY" dist/ambitious-video.pyz cache list --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/cache-list.json"
"$PY" dist/ambitious-video.pyz cache prune --older-than 90 --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/cache-prune.json"
"$PY" - "$WORK" <<'PY'
import json, sys
from pathlib import Path
work = Path(sys.argv[1])
one, two = (json.loads((work / name).read_text(encoding="utf-8")) for name in ("plan-a.json", "plan-b.json"))
if not one["ok"] or one["data"] != two["data"] or len(one["data"]["planSha256"]) != 64:
    raise SystemExit("plan changed with the clock")
listed = json.loads((work / "cache-list.json").read_text(encoding="utf-8"))
pruned = json.loads((work / "cache-prune.json").read_text(encoding="utf-8"))
if not listed["ok"] or listed["data"]["entries"] != [] or not pruned["ok"] or pruned["data"]["removed"] != []:
    raise SystemExit("the cache of a free render must be empty")
print("planSha256", one["data"]["planSha256"], "cache entries", listed["data"]["count"])
PY

echo "== keys on demand: the estimate names the missing key, render stops before any call =="
cat >"$WORK/spoken.json" <<'JSON'
{
  "schemaVersion": 2,
  "output": { "path": "out/spoken.mp4", "width": 320, "height": 180, "fps": 10 },
  "tracks": [
    {
      "id": "main",
      "clips": [{ "type": "title_card", "duration": 2.0, "text": "Spoken or shown" }]
    },
    {
      "id": "voice",
      "clips": [
        { "type": "speech", "at": 0.2, "duration": 1.5, "text": "A line for a voice.", "provider": "xai-speech", "model": "tts", "voice": "eve" }
      ]
    },
    { "id": "captions", "from": "voice" }
  ]
}
JSON
"$PY" dist/ambitious-video.pyz estimate --in "$WORK/spoken.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/keys-estimate.json"
"$PY" dist/ambitious-video.pyz plan --in "$WORK/spoken.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/keys-plan.json"
"$PY" dist/ambitious-video.pyz render --in "$WORK/spoken.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/keys-render.json" || true
"$PY" - "$WORK" <<'PY'
import json, sys
from pathlib import Path
work = Path(sys.argv[1])
estimate, plan, render = (
    json.loads((work / f"keys-{name}.json").read_text(encoding="utf-8")) for name in ("estimate", "plan", "render")
)
wanted = [{"env": "XAI_API_KEY", "provider": "xai-speech", "steps": [1], "usd": "0.000285"}]
if not estimate["ok"] or estimate["data"]["secretsNeeded"] != wanted or plan["data"]["secretsNeeded"] != wanted:
    raise SystemExit("estimate and plan must list the one missing key")
if render["ok"] or [error["code"] for error in render["errors"]] != ["E_NO_KEY"] or render["data"] != {"missing": wanted}:
    raise SystemExit("render without the key must stop with E_NO_KEY and data.missing")
if (work / "out" / "spoken.mp4").exists():
    raise SystemExit("a refused render must write nothing")
print("secretsNeeded", wanted[0]["env"], wanted[0]["usd"])
PY

echo "== spending cap: an estimate above the cap stops estimate and render before any call =="
"$PY" - "$WORK" <<'PY'
import json, sys
from pathlib import Path
work = Path(sys.argv[1])
spoken = json.loads((work / "spoken.json").read_text(encoding="utf-8"))
spoken["budget"] = {"maxUsd": 0.0002}
spoken["output"]["path"] = "out/capped.mp4"
(work / "capped.json").write_text(json.dumps(spoken, indent=2), encoding="utf-8")
PY
"$PY" dist/ambitious-video.pyz jobs --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/cap-before.json"
"$PY" dist/ambitious-video.pyz estimate --in "$WORK/capped.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/cap-estimate.json" || true
XAI_API_KEY=not-a-real-key "$PY" dist/ambitious-video.pyz render --in "$WORK/capped.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/cap-render.json" || true
"$PY" dist/ambitious-video.pyz estimate --in "$WORK/capped.json" --max-usd 0.0001 --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/cap-flag.json" || true
"$PY" dist/ambitious-video.pyz estimate --in "$WORK/spoken.json" --max-usd 1 --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/cap-under.json"
"$PY" dist/ambitious-video.pyz estimate --in "$WORK/capped.json" --offline --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/cap-offline.json"
"$PY" dist/ambitious-video.pyz jobs --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/cap-jobs.json"
"$PY" - "$WORK" <<'PY'
import json, sys
from pathlib import Path
work = Path(sys.argv[1])
estimate, render, flag, under, offline, before, jobs = (
    json.loads((work / f"cap-{name}.json").read_text(encoding="utf-8"))
    for name in ("estimate", "render", "flag", "under", "offline", "before", "jobs")
)
over = {"estimate": "0.000285", "cap": "0.000200", "source": "budget.maxUsd"}
for body in (estimate, render, flag):
    if body["ok"] or [error["code"] for error in body["errors"]] != ["E_BUDGET"]:
        raise SystemExit("an estimate above the cap must stop with E_BUDGET")
if render["data"] != over or {name: estimate["data"][name] for name in over} != over:
    raise SystemExit("E_BUDGET must name the estimate, the cap and its source")
if (flag["data"]["cap"], flag["data"]["source"]) != ("0.000100", "--max-usd"):
    raise SystemExit("the lower of budget.maxUsd and --max-usd must apply")
if not under["ok"] or under["data"]["budget"] != {"cap": "1.000000", "source": "--max-usd"}:
    raise SystemExit("an estimate under the cap must pass and name the cap")
if not offline["ok"] or offline["data"]["usd"] != "0.000000":
    raise SystemExit("an offline estimate costs nothing and passes the cap")
if (work / "out" / "capped.mp4").exists() or jobs["data"] != before["data"]:
    raise SystemExit("a render refused for its cost must write nothing and create no job")
print("E_BUDGET", over["estimate"], ">", over["cap"], over["source"])
PY

echo "== two providers: only the key that is not set is asked for =="
cat >"$WORK/two-keys.json" <<'JSON'
{
  "schemaVersion": 2,
  "disclosure": "AI-generated scenes",
  "output": { "path": "out/two-keys.mp4", "width": 320, "height": 180, "fps": 10 },
  "tracks": [
    {
      "id": "main",
      "clips": [
        {
          "type": "generated_scene",
          "provider": "xai-image",
          "model": "grok-imagine-image",
          "prompt": "A tidy shop front on a quiet street, no people, no text",
          "duration": 2,
          "fallback": { "type": "title_card", "text": "Spoken or shown" }
        }
      ]
    },
    {
      "id": "voice",
      "clips": [
        { "type": "speech", "at": 0.2, "duration": 1.5, "text": "A line for a voice.", "provider": "elevenlabs-speech", "model": "eleven-v4", "voice": "an-owner-voice-id" }
      ]
    },
    { "id": "captions", "from": "voice" }
  ]
}
JSON
"$PY" dist/ambitious-video.pyz validate --in "$WORK/two-keys.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >/dev/null
"$PY" dist/ambitious-video.pyz estimate --in "$WORK/two-keys.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/two-keys-none.json"
XAI_API_KEY=not-a-real-key "$PY" dist/ambitious-video.pyz estimate --in "$WORK/two-keys.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/two-keys-one.json"
"$PY" - "$WORK" <<'PY'
import json, sys
from pathlib import Path
work = Path(sys.argv[1])
none, one = (json.loads((work / f"two-keys-{name}.json").read_text(encoding="utf-8")) for name in ("none", "one"))
speech = {"env": "ELEVENLABS_API_KEY", "provider": "elevenlabs-speech", "steps": [1], "usd": "0.001520"}
scene = {"env": "XAI_API_KEY", "provider": "xai-image", "steps": [0], "usd": "0.020000"}
if not none["ok"] or none["data"]["secretsNeeded"] != [speech, scene]:
    raise SystemExit("with no key set, both variables must be listed, each with its own steps")
if not one["ok"] or one["data"]["secretsNeeded"] != [speech] or one["data"]["usd"] != "0.021520":
    raise SystemExit("with one key set, only the other variable must be listed, for the speech step alone")
if "not-a-real-key" in json.dumps([none, one]):
    raise SystemExit("an estimate must never hold a key value")
print("secretsNeeded", speech["env"], speech["usd"], "of", one["data"]["usd"])
PY

echo "== --offline: fallbacks, 0.000000, the same plan and the same file twice =="
"$PY" dist/ambitious-video.pyz plan --offline --in "$WORK/spoken.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/offline-plan-a.json"
"$PY" dist/ambitious-video.pyz plan --offline --in "$WORK/spoken.json" --now 2031-07-09T12:34:56Z --seed 2 </dev/null >"$WORK/offline-plan-b.json"
"$PY" dist/ambitious-video.pyz estimate --offline --in "$WORK/spoken.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/offline-estimate.json"
"$PY" dist/ambitious-video.pyz render --offline --in "$WORK/spoken.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/offline-render-a.json"
"$PY" dist/ambitious-video.pyz render --offline --in "$WORK/spoken.json" --now 2026-01-02T00:00:00Z --seed 2 </dev/null >"$WORK/offline-render-b.json"
"$PY" dist/ambitious-video.pyz ledger --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/offline-ledger.json"
"$PY" - "$WORK" <<'PY'
import json, sys
from pathlib import Path
work = Path(sys.argv[1])
def read(name):
    body = json.loads((work / f"offline-{name}.json").read_text(encoding="utf-8"))
    if not body["ok"]:
        raise SystemExit(body)
    return body["data"]
plan, again, estimate, one, two, ledger = (
    read(name) for name in ("plan-a", "plan-b", "estimate", "render-a", "render-b", "ledger")
)
if plan != again or plan["secretsNeeded"] != [] or any(step["paid"] for step in plan["steps"]):
    raise SystemExit("the offline plan must repeat, need no key and hold no paid step")
if [step.get("fallback") for step in plan["steps"]] != [None, "captions"]:
    raise SystemExit("the speech step must be marked with its fallback")
if estimate["usd"] != "0.000000" or estimate["secretsNeeded"] != []:
    raise SystemExit("the offline estimate must be 0.000000")
if one["costUsd"] != "0.000000" or two["costUsd"] != "0.000000" or one["sha256"] != two["sha256"]:
    raise SystemExit("two offline renders must cost nothing and write the same file")
if [step["fallback"] for step in one["steps"]] != ["captions"] or one["planSha256"] != plan["planSha256"]:
    raise SystemExit("the offline render must list the fallback and the offline plan")
if ledger["lines"] != []:
    raise SystemExit("an offline render must add no ledger line")
print("offline", one["costUsd"], one["sha256"])
PY

echo "== samples: template + inputs + brand -> script -> plan -> estimate -> offline render -> verify =="
for sample in examples/samples/*/; do
  slug="$(basename "$sample")"
  at="$WORK/samples/$slug"
  mkdir -p "$WORK/samples"
  cp -R "$sample" "$at"
  rm "$at/script.json"
  "$PY" - "$at" <<'PY'
import json, sys
from pathlib import Path
folder = Path(sys.argv[1])
inputs = json.loads((folder / "inputs.json").read_text(encoding="utf-8"))
small = {"width": 180, "height": 320} if inputs["template"] == "announcement" else {"width": 320, "height": 180}
inputs["inputs"]["voice"] = "narrator"
inputs["output"] = {"path": "out/small.mp4", "fps": 10, **small}
(folder / "small.json").write_text(json.dumps(inputs), encoding="utf-8")
(folder / "template.txt").write_text(inputs["template"], encoding="utf-8")
PY
  template="$(cat "$at/template.txt")"
  "$PY" dist/ambitious-video.pyz expand --template "$template" --in "$at/inputs.json" --out "$at/script.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$at/expand-a.json"
  "$PY" dist/ambitious-video.pyz expand --template "templates/$template.json" --in "$at/inputs.json" --out "$at/again.json" --now 2031-07-09T12:34:56Z --seed 2 </dev/null >"$at/expand-b.json"
  cmp "$at/script.json" "${sample}script.json"
  cmp "$at/script.json" "$at/again.json"
  "$PY" dist/ambitious-video.pyz validate --in "$at/script.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$at/validate.json"
  "$PY" dist/ambitious-video.pyz plan --in "$at/script.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$at/plan-a.json"
  "$PY" dist/ambitious-video.pyz plan --in "$at/again.json" --now 2031-07-09T12:34:56Z --seed 2 </dev/null >"$at/plan-b.json"
  "$PY" dist/ambitious-video.pyz estimate --in "$at/script.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$at/estimate.json"
  "$PY" dist/ambitious-video.pyz expand --template "$template" --in "$at/small.json" --out "$at/small-script.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$at/small-expand.json"
  "$PY" dist/ambitious-video.pyz estimate --in "$at/small-script.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$at/small-estimate.json"
  "$PY" dist/ambitious-video.pyz render --offline --in "$at/small-script.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$at/small-render.json"
  "$PY" - "$at" "$template" <<'PY'
import json, sys
from pathlib import Path
at, template = Path(sys.argv[1]), sys.argv[2]
def read(name):
    body = json.loads((at / f"{name}.json").read_text(encoding="utf-8"))
    if not body["ok"]:
        raise SystemExit(body)
    return body["data"]
one, two, plan, again, estimate = (read(name) for name in ("expand-a", "expand-b", "plan-a", "plan-b", "estimate"))
if one["script"] != two["script"] or one["scriptSha256"] != two["scriptSha256"] or one["template"]["id"] != template:
    raise SystemExit("the same template and inputs must expand to the same script")
if plan != again or plan["template"] != {"id": template, "templateVersion": 1}:
    raise SystemExit("the plan of an expanded script must repeat and name its template")
if one["script"]["budget"] != {"maxUsd": 5} or one["script"]["disclosure"] != "AI-generated scenes":
    raise SystemExit("a script from a starter template must carry its budget of 5 and its disclosure text")
if estimate["usd"] != "0.000000" or estimate["secretsNeeded"] != [] or not read("validate")["ok"]:
    raise SystemExit("a sample without a voice must need no key and cost nothing")
spoken, render = read("small-estimate"), read("small-render")
if [entry["env"] for entry in spoken["secretsNeeded"]] != ["XAI_API_KEY"] or not 0 < float(spoken["usd"]) < 5:
    raise SystemExit("a sample with a voice must name the one key it needs and stay under its budget")
if render["costUsd"] != "0.000000" or not render["steps"]:
    raise SystemExit("the offline render of a spoken sample must cost nothing")
if any(step["fallback"] != "captions" for step in render["steps"]):
    raise SystemExit("the offline render of a spoken sample must take the captions fallback")
json.dump({"jobId": render["jobId"]}, open(at / "job.json", "w", encoding="utf-8"))
print(at.name, "from", template, plan["durationSec"], "s,", len(plan["steps"]), "steps,", plan["planSha256"][:12])
PY
  "$PY" dist/ambitious-video.pyz verify --in "$at/job.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$at/verify.json"
  "$PY" - "$at/verify.json" <<'PY'
import json, sys
body = json.load(open(sys.argv[1], encoding="utf-8"))
if not body["ok"] or not body["data"]["passed"]:
    raise SystemExit(body)
PY
done

echo "== generated scenes: priced per second, key asked, fallback offline, manifest written =="
mkdir -p "$WORK/scenes/assets"
cp examples/generated-scenes.json "$WORK/scenes/scenes.json"
cp examples/assets/still.png "$WORK/scenes/assets/still.png"
"$PY" - "$WORK/scenes/scenes.json" <<'PY'
import json, sys
from pathlib import Path
path = Path(sys.argv[1])
doc = json.loads(path.read_text(encoding="utf-8"))
doc["output"]["width"] = 320
doc["output"]["height"] = 180
doc["output"]["fps"] = 10
path.write_text(json.dumps(doc, indent=2), encoding="utf-8")
PY
"$PY" dist/ambitious-video.pyz estimate --in "$WORK/scenes/scenes.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/scenes/estimate.json"
"$PY" dist/ambitious-video.pyz plan --in "$WORK/scenes/scenes.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/scenes/plan-a.json"
"$PY" dist/ambitious-video.pyz plan --in "$WORK/scenes/scenes.json" --now 2031-07-09T12:34:56Z --seed 2 </dev/null >"$WORK/scenes/plan-b.json"
"$PY" dist/ambitious-video.pyz render --in "$WORK/scenes/scenes.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/scenes/refused.json" || true
"$PY" dist/ambitious-video.pyz plan --offline --in "$WORK/scenes/scenes.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/scenes/offline-plan.json"
"$PY" dist/ambitious-video.pyz render --offline --in "$WORK/scenes/scenes.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/scenes/render-a.json"
"$PY" dist/ambitious-video.pyz render --offline --in "$WORK/scenes/scenes.json" --now 2026-01-02T00:00:00Z --seed 2 </dev/null >"$WORK/scenes/render-b.json"
"$PY" dist/ambitious-video.pyz ledger --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/scenes/ledger.json"
"$PY" - "$WORK/scenes" <<'PY'
import json, sys
from pathlib import Path
at = Path(sys.argv[1])
def read(name, ok=True):
    body = json.loads((at / f"{name}.json").read_text(encoding="utf-8"))
    if body["ok"] is not ok:
        raise SystemExit(body)
    return body
estimate, plan, again = (read(name)["data"] for name in ("estimate", "plan-a", "plan-b"))
paid = [line for line in estimate["breakdown"] if "provider" in line]
priced = [(line["provider"], line["unit"], line["units"], line["usdPerUnit"], line["usd"]) for line in paid]
if priced != [("xai-video", "second", "8", "0.05", "0.400000"), ("xai-image", "image", "1", "0.02", "0.020000")]:
    raise SystemExit("a moving scene is priced per second and a still per picture")
wanted = [{"env": "XAI_API_KEY", "provider": "xai-image, xai-video", "steps": [1, 2], "usd": "0.420000"}]
if estimate["usd"] != "0.420000" or estimate["secretsNeeded"] != wanted or plan != again:
    raise SystemExit("the estimate must name the one key, and the plan must repeat on another day")
refused = read("refused", ok=False)
if [error["code"] for error in refused["errors"]] != ["E_NO_KEY"] or refused["data"] != {"missing": wanted}:
    raise SystemExit("a render without the key must stop with E_NO_KEY and name the key")
offline, one, two, ledger = (read(name)["data"] for name in ("offline-plan", "render-a", "render-b", "ledger"))
if one["costUsd"] != "0.000000" or one["sha256"] != two["sha256"] or ledger["lines"] != []:
    raise SystemExit("two offline renders must cost nothing and write the same file")
if [step["fallback"] for step in one["steps"]] != ["image", "title_card"]:
    raise SystemExit("each generated scene must take its own fallback")
manifest = json.loads(Path(two["manifest"]).read_text(encoding="utf-8"))
if Path(two["manifest"]).name != "generated-scenes.mp4.manifest.json" or manifest["template"] is not None:
    raise SystemExit("the manifest must sit next to the video and name no template for a hand-written script")
if manifest["planSha256"] != offline["planSha256"] or manifest["output"]["sha256"] != two["sha256"]:
    raise SystemExit("the manifest must name the plan and the file that were rendered")
named = ("index", "type", "provider", "model", "stepKey", "paid", "cached", "usd")
steps = manifest["steps"]
if len(steps) != len(offline["steps"]) or any(name not in step for step in steps for name in named):
    raise SystemExit("the manifest must list every step with its provider, model, stepKey, cached and usd")
if [step.get("fallback") for step in steps] != [None, "image", "title_card", None] or manifest["offline"] is not True:
    raise SystemExit("the manifest must mark the steps that took a fallback")
json.dump({"jobId": two["jobId"]}, open(at / "job.json", "w", encoding="utf-8"))
print("scenes", estimate["usd"], "usd online,", one["costUsd"], "offline, manifest", Path(two["manifest"]).name)
PY
"$PY" dist/ambitious-video.pyz verify --in "$WORK/scenes/job.json" --now 2026-01-01T00:00:00Z --seed 1 </dev/null >"$WORK/scenes/verify.json"
"$PY" - "$WORK/scenes/verify.json" <<'PY'
import json, sys
body = json.load(open(sys.argv[1], encoding="utf-8"))
if not body["ok"] or not body["data"]["passed"]:
    raise SystemExit(body)
PY

